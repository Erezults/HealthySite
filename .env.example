# Environment variables for the Healthy marketing site.
# Copy to .env.local for local development; set the same vars in Vercel for deploys.
# All values here are PUBLIC (NEXT_PUBLIC_* is inlined into the client bundle).
# NEVER put the Supabase service-role key (or any secret) in this app.

# Supabase Edge Functions base URL (used by /share/[token] and /auth/confirm).
# e.g. https://sqksoiwzrbtkedsfucal.supabase.co/functions/v1
NEXT_PUBLIC_SUPABASE_FUNCTIONS_URL=

# Supabase public anon key (Project Settings → API → anon public).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Optional: default deep-link scheme for /auth/confirm when ?scheme= is absent.
# Allowed values: healthynative (prod) | healthynative-dev. Defaults to healthynative.
NEXT_PUBLIC_APP_SCHEME=
